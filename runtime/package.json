{
  "name": "@nova-personal-agent/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./executors/codex/version": {
      "types": "./dist/src/executors/codex/version.d.ts",
      "default": "./dist/src/executors/codex/version.js"
    },
    "./desktop": {
      "types": "./dist/src/desktop.d.ts",
      "default": "./dist/src/desktop.js"
    },
    "./usage": {
      "types": "./dist/src/usage/index.d.ts",
      "default": "./dist/src/usage/index.js"
    },
    "./space-host": {
      "types": "./dist/src/space-host/config.d.ts",
      "default": "./dist/src/space-host/config.js"
    }
  },
  "bin": {
    "nova-personal-agent-node": "./dist/src/cli.js",
    "nova-space-host": "./dist/src/space-host/cli.js"
  },
  "files": [
    "scripts/autoglm-bridge.py",
    "scripts/patch-pi-acp.mjs",
    "scripts/patch-codebuddy-recovery.mjs",
    "scripts/patch-acp-recovery.mjs",
    "dist/src",
    "dist/eval",
    "scripts/opencode-recovery.mjs",
    "scripts/install-opencode-recovery.mjs"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "server": "node dist/src/server-entry.js",
    "server:pair": "node scripts/pair-device.mjs",
    "test:pair": "node --test scripts/pair-device.test.mjs",
    "server:token-init": "node dist/src/server-entry.js token-init",
    "clean": "node scripts/clean-dist.mjs",
    "demo": "npm run build && node dist/src/cli.js demo",
    "fixtures:check": "npm run build && node dist/src/cli.js fixture check",
    "lint": "eslint src eval test",
    "smoke:qwen": "npm run build && node scripts/live-smoke.mjs --target=qwen",
    "smoke:cascaded": "npm run build && node scripts/live-smoke.mjs --target=cascaded",
    "smoke:qwen:surrogate": "npm run build && node scripts/live-smoke.mjs --target=qwen-surrogate",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:win": "npm run build && node scripts/test-windows.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:search:mcp": "npm run build && node scripts/live-smoke.mjs --target=search-mcp",
    "smoke:knowledge": "npm run build && node scripts/live-smoke.mjs --target=knowledge",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "test:live:contract": "npm run build && node --test scripts/live/*contract.test.mjs",
    "test:win:platform": "npm run build && node scripts/test-windows.mjs --platform-only",
    "prebuild": "npm run build --workspace @nova-personal-agent/relay"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@computer-use/libnut": "4.2.0",
    "@livekit/agents": "1.6.4",
    "@livekit/local-inference": "0.2.7",
    "@livekit/rtc-node": "0.13.33",
    "@midscene/computer": "1.12.9",
    "@midscene/core": "1.12.9",
    "@midscene/shared": "1.12.9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.11.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.2",
    "mem0ai": "3.2.0",
    "pdfjs-dist": "6.2.108",
    "pg": "8.11.3",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "saxes": "^6.0.0",
    "smol-toml": "1.9.1",
    "undici": "7.29.0",
    "voicemem": "0.0.1",
    "ws": "8.21.3",
    "zod": "4.4.3",
    "@nova-personal-agent/relay": "1.0.0",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "sharp": "0.35.3"
  }
}
