{
  "name": "@nova-personal-agent/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "relay",
    "push-gateway",
    "runtime",
    "clients/desktop",
    "cli"
  ],
  "scripts": {
    "start:client": "node scripts/start-client.mjs",
    "start:workbench": "node scripts/start-client.mjs --workbench",
    "start:client_demo": "node scripts/start-client-demo.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck --workspace @nova-personal-agent/runtime && npm run lint --workspace @nova-personal-agent/runtime && npm run check:env-contract && node --test clients/desktop/test/wire-frame-types.test.mjs && node runtime/scripts/check-capabilities.mjs --check",
    "check:env-contract": "npm run build --workspace @nova-personal-agent/runtime && node runtime/scripts/check-env-contract.mjs --check",
    "fixtures:schema": "npm run build --workspace @nova-personal-agent/runtime && node runtime/scripts/generate-fixture-schema.mjs",
    "fixtures:schema:session": "npm run build --workspace @nova-personal-agent/runtime && node runtime/scripts/generate-session-fixture-schema.mjs",
    "package:linux": "npm run package:linux --workspace @nova-personal-agent/desktop",
    "package:mac": "npm run package:mac --workspace @nova-personal-agent/desktop",
    "package:mac:candidate": "npm run package:mac:candidate --workspace @nova-personal-agent/desktop",
    "package:win": "npm run package:win --workspace @nova-personal-agent/desktop",
    "test": "npm run test:runtime && npm run test:desktop && npm run test:cli && npm run test:server-cli",
    "test:cli": "npm test --workspace nova-personal-agent",
    "test:desktop": "npm test --workspace @nova-personal-agent/desktop",
    "test:runtime": "npm test --workspace @nova-personal-agent/runtime",
    "test:runtime:win": "npm run test:win --workspace @nova-personal-agent/runtime",
    "test:runtime:win:platform": "npm run test:win:platform --workspace @nova-personal-agent/runtime",
    "test:server-cli": "node --test server-cli/test/*.test.mjs",
    "test:relay": "node relay/scripts/test.mjs",
    "check:relay": "npm run typecheck --workspace @nova-personal-agent/relay",
    "test:push-gateway": "node push-gateway/scripts/test.mjs",
    "check:push-gateway": "npm run typecheck --workspace @nova-personal-agent/push-gateway",
    "build:space": "node scripts/build-space-stack.mjs",
    "test:space": "node scripts/test-space-stack.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "license": "GPL-3.0-or-later"
}
